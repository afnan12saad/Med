rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getPatient(patientId) {
      return get(/databases/$(database)/documents/users/$(patientId)).data;
    }

    // User collection rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Records collection rules
    // Reminder Rules
    function isValidReminder(data) {
      return data.keys().hasAll(['patientId', 'title', 'time', 'active', 'createdAt']) &&
             data.patientId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.time is string &&
             data.active is bool &&
             data.createdAt == request.time;
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) // Simplified doctor check for dev
      );
      allow create: if isSignedIn() && isValidReminder(incoming()) && incoming().patientId == request.auth.uid;
      allow update: if isSignedIn() && incoming().patientId == request.auth.uid && 
                   incoming().diff(existing()).affectedKeys().hasOnly(['title', 'time', 'active', 'days']);
      allow delete: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    match /records/{recordId} {
      allow read: if isOwner(resource.data.patientId) || (
        isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' &&
        getPatient(resource.data.patientId).sharingEnabled == true
      );
      allow create: if isOwner(request.resource.data.patientId);
      allow delete: if isOwner(resource.data.patientId);
    }
  }
}
